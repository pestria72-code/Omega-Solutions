# Environment Variables for Omega Solutions ERP Frontend

# Backend API URL — the NestJS API base URL (without trailing slash)
# In development, the backend runs on localhost:3000 with /api prefix
VITE_API_BASE_URL=http://localhost:3000/api

# Google Tag Manager ID (optional)
VITE_GTM_ID=

# Base path for deployment (optional)
VITE_BASENAME=
