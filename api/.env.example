# ─────────────────────────────────────────────────────────────
# Omega Solutions — Backend Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and replace the placeholder values
# with your real credentials. NEVER commit .env to git.

# Neon PostgreSQL connection string.
# Get this from the Neon Console → your project → Connection Details.
# Format: postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require

# JWT secrets for authentication tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-64-byte-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-64-byte-hex-string

# JWT expiration times (optional — defaults shown)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server port (optional — default 3000)
PORT=3000

# Frontend origin for CORS (your frontend URL; use localhost for local dev)
CORS_ORIGIN=http://localhost:5173
